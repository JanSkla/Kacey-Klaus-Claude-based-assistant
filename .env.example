# Kacey backend configuration. Copy to .env and adjust, or just set these in your
# shell — the server reads plain environment variables (no dotenv dependency).

# HTTP + WebSocket port.
PORT=8082

# Interface to listen on. Loopback by default — this server hands out a
# logged-in Claude session, so it should never reach a network by accident.
# Set it to a Tailscale address to serve the tailnet, or 0.0.0.0 for all
# interfaces. Remember that the microphone needs https or localhost.
HOST=127.0.0.1

# Claude model driving the assistant.
KACEY_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max (default low)
KACEY_EFFORT=low

# Kacey's system prompt. Edit the file, restart the server — no code changes needed.
KACEY_PERSONA_PATH=./persona/kacey.md

# Python interpreter used to launch the klaus_memory MCP server.
# klaus_memory is pure stdlib (sqlite3/json/urllib) — nothing to pip install.
PYTHON_BIN=python

# The REAL memory database. This is passed to klaus_memory as --db.
# IMPORTANT: --db always overrides the KLAUS_DB env var inside klaus_memory itself
# and defaults to "klaus-memory.db", so the server always passes it explicitly.
# Point this at the wrong path and you get a fresh, empty database.
# Verified: this file has 8 facts + embeddings. The sibling
# C:\repos\hobby\lukas\Klaus\klaus.db is schema-only with zero facts.
KLAUS_DB=C:\repos\hobby\lukas\Klaus\Kacey-mvp\klaus.db

# Directory CONTAINING the klaus_memory package (not the package itself).
KLAUS_MEMORY_PYTHONPATH=C:\repos\hobby\lukas\Klaus\Kacey-mvp

# Declaration of the real calendar sources (Google "osobni"/"prace", TimeTree
# "rodina"), passed as --calendars. Without it klaus_memory knows a single
# in-memory source named "local". Reads still look right - they come from the
# SQLite mirror - but every write fails with "neznamy kalendarni zdroj 'osobni'".
# Credentials are NOT in this file, only the path to the .env that holds them.
# Defaults to <KLAUS_MEMORY_PYTHONPATH>\calendars.json.
# KLAUS_CALENDARS=C:\repos\hobby\lukas\Klaus\Kacey-mvp\calendars.json

# The .env holding the Google OAuth credentials, passed as --env. It must be
# explicit: klaus_memory searches for .env from its working directory UPWARDS,
# and the server spawns it from this repo, so the memory tree's .env sits on a
# sibling branch and is never found. Defaults to <KLAUS_MEMORY_PYTHONPATH>\.env.
# Either file missing is a startup warning, not a crash.
# KLAUS_ENV_FILE=C:\repos\hobby\lukas\Klaus\Kacey-mvp\.env

# Authentication comes from the Claude CLI: run `claude` once and log in.
# No ANTHROPIC_API_KEY is needed in that case. If you prefer a key, set it here.
# ANTHROPIC_API_KEY=

# Kacey backend configuration. Copy to .env and adjust, or just set these in your
# shell — the server reads plain environment variables (no dotenv dependency).

# HTTP + WebSocket port.
PORT=8787

# Claude model driving the assistant.
KACEY_MODEL=claude-opus-5

# Kacey's system prompt. Edit the file, restart the server — no code changes needed.
KACEY_PERSONA_PATH=./persona/kacey.md

# Python interpreter used to launch the klaus_memory MCP server.
# klaus_memory is pure stdlib (sqlite3/json/urllib) — nothing to pip install.
PYTHON_BIN=python

# The REAL memory database. This is passed to klaus_memory as --db.
# IMPORTANT: --db always overrides the KLAUS_DB env var inside klaus_memory itself
# and defaults to "klaus-memory.db", so the server always passes it explicitly.
# Point this at the wrong path and you get a fresh, empty database.
# Verified: this file has 8 facts + embeddings. The sibling
# C:\repos\hobby\lukas\Klaus\klaus.db is schema-only with zero facts.
KLAUS_DB=C:\repos\hobby\lukas\Klaus\Kacey-mvp\klaus.db

# Directory CONTAINING the klaus_memory package (not the package itself).
KLAUS_MEMORY_PYTHONPATH=C:\repos\hobby\lukas\Klaus\Kacey-mvp

# Authentication comes from the Claude CLI: run `claude` once and log in.
# No ANTHROPIC_API_KEY is needed in that case. If you prefer a key, set it here.
# ANTHROPIC_API_KEY=

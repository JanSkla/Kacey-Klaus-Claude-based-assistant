        <mxCell id="C1" value="&lt;b&gt;commands.js&lt;/b&gt; — bargeIn() / endListening()&lt;div&gt;✖ nothing is sent to the model&lt;/div&gt;&lt;div&gt;✖ nothing is written to the transcript&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">

        </mxCell>
        <mxCell id="N1" value="&lt;i&gt;Invariant 3: the log mirrors what the model saw. A spoken command or a wake word must never appear in it. See page 2 for what happens next.&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=6;fontSize=10;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="570" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="P2" value="&lt;b&gt;not a command&lt;/b&gt;&lt;div&gt;cancelSpeech() — silence the old answer&lt;/div&gt;&lt;div&gt;noteTurn()&lt;/div&gt;&lt;div&gt;addMessage('user') — textContent only&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">

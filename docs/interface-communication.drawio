        <mxCell id="R1" value="&lt;b&gt;recognition.js — dictation&lt;/b&gt;&lt;div&gt;onresult (final)&lt;/div&gt;&lt;div&gt;→ micDesired = false&lt;/div&gt;&lt;div&gt;→ resumeVoiceLoop = true&lt;/div&gt;&lt;div&gt;→ stopRecognition(false)&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">

        <mxCell id="CORE_BG" value="the interrupt core — protocol.js / commands.js" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef8f8;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#b85450;" vertex="1" parent="1">

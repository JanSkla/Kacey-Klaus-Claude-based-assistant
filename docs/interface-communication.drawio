        <mxCell id="W1" value="&lt;b&gt;wake.js / wake-panel.js&lt;/b&gt;&lt;div&gt;wake word heard (transcript match or voice template)&lt;/div&gt;&lt;div&gt;→ stopWake(true)&lt;/div&gt;&lt;div&gt;→ state.micDesired = true&lt;/div&gt;&lt;div&gt;→ playWakeChime()&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">

        <mxCell id="P3" value="&lt;b&gt;transport.send()&lt;/b&gt;&lt;div&gt;{ type: 'user_message', text }&lt;/div&gt;&lt;div&gt;&lt;i&gt;socket or mock — the pipeline never knows which&lt;/i&gt;&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">

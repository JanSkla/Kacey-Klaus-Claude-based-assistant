        <mxCell id="TA" value="&lt;b&gt;A · &quot;ticho&quot; / &quot;dost&quot;&lt;/b&gt;&lt;div&gt;said out loud &lt;b&gt;while she is still talking&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=6;fontSize=11;" vertex="1" parent="1">

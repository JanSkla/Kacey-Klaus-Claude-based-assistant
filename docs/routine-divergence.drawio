        <mxCell id="B10" value="   group_kind TEXT  move | range" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="246" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B11" value="   overlap    TEXT NULL  pending | keep" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="270" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B12" value="   origin     TEXT  user | kacey" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="294" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B13" value="   created_at TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="318" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B14" value="&lt;i&gt;Changes for one specific date. A &lt;b&gt;move&lt;/b&gt; is a cancel plus an add. A &lt;b&gt;sick range&lt;/b&gt; is one cancel per day covering the whole day. The rows of a move or a range share a group_id, so they can be undone together.&lt;/i&gt;" style="text;strokeColor=none;fillColor=#f1f8ef;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="B"><mxGeometry y="342" width="340" height="64" as="geometry" /></mxCell>

        <!-- C · cemented history (new) -->
        <mxCell id="C" value="kacey_routine_day  ·  CEMENTED HISTORY (new)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;rounded=1;arcSize=5;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="790" y="90" width="340" height="262" as="geometry" />
        </mxCell>
        <mxCell id="C1" value="PK date        TEXT  logical YYYY-MM-DD" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="C"><mxGeometry y="30" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C2" value="   blocks      JSON  [{cat,s,e,note,room,who,state}]" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=11;" vertex="1" parent="C"><mxGeometry y="54" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C3" value="     state = template | cancelled | moved_out | added | moved_in" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=11;fontColor=#666666;" vertex="1" parent="C"><mxGeometry y="78" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C4" value="   cemented_at TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="C"><mxGeometry y="102" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C5" value="   source      TEXT  rollover | catchup" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="C"><mxGeometry y="126" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C6" value="   amended_at  TEXT NULL  (late Kacey change)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="C"><mxGeometry y="150" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C7" value="   prev_blocks JSON NULL  (copy before last amend)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="C"><mxGeometry y="174" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="C8" value="&lt;i&gt;A frozen copy of the day as it actually was, written once when the day ends. Edits to the default week never change it. &lt;b&gt;Only Kacey's chat can amend it later&lt;/b&gt;, and the amend is applied onto this copy, not onto the default week.&lt;/i&gt;" style="text;strokeColor=none;fillColor=#f7f2f9;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="C"><mxGeometry y="198" width="340" height="64" as="geometry" /></mxCell>

        <!-- R · resolver -->
        <mxCell id="R" value="&lt;b&gt;blocksForDate(D)&lt;/b&gt;&lt;br&gt;if D is cemented → return its snapshot&lt;br&gt;otherwise → template[weekday(D)] − cancels + adds&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#7a6a2a&quot;&gt;one shared module (core/), used by both server and client&lt;/font&gt;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="540" width="330" height="90" as="geometry" />
        </mxCell>

        <!-- consumers -->
        <mxCell id="K1" value="&lt;b&gt;Calendar UI&lt;/b&gt; (.rblock)&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;cancelled = ghost · added = badge · ⚠ overlap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">

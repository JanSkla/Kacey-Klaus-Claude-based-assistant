        <mxCell id="d3b2" value="&lt;s&gt;gym · Běh · 18:00–19:00&lt;/s&gt;&lt;br&gt;✕ cancel #12 · &quot;still sick&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontColor=#9a3b36;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="d3"><mxGeometry x="10" y="86" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="d3f" value="Can still be undone, changed or reset (UI or Kacey).&lt;br&gt;Cements Thu 8. 10. at 04:00." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#8a7320;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="d3"><mxGeometry x="10" y="214" width="180" height="66" as="geometry" /></mxCell>


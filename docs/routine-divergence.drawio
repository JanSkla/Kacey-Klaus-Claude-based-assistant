        <mxCell id="d5b1" value="work · 08:00–16:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="d5"><mxGeometry x="10" y="36" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="d5b2" value="gym · Běh · 18:00–19:00" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;spacingLeft=6;fontSize=11;" vertex="1" parent="d5"><mxGeometry x="10" y="86" width="180" height="40" as="geometry" /></mxCell>
        <mxCell id="d5f" value="↺ This day was altered, then &lt;b&gt;reset to default&lt;/b&gt;. Its overrides were deleted, so it follows the default week again." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#4e6f99;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="d5"><mxGeometry x="10" y="214" width="180" height="66" as="geometry" /></mxCell>


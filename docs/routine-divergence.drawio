        <mxCell id="B4" value="   slot_from  INTEGER" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="102" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B5" value="   slot_to    INTEGER (exclusive)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="126" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B6" value="   category   TEXT  (cancel: NULL = any)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="150" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B7" value="   note / room / who  TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="174" width="340" height="24" as="geometry" /></mxCell>
        <mxCell id="B8" value="   reason     TEXT  e.g. &quot;nemoc&quot;" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="B"><mxGeometry y="198" width="340" height="24" as="geometry" /></mxCell>

        <mxCell id="t1" value="&lt;b&gt;Routine divergence · data model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;The default week table stays as it is. Two new tables are added: alterations for specific dates, and cemented day history. Writes are on page 4.&lt;/font&gt;" style="text;html=1;fontSize=20;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1000" height="60" as="geometry" />
        </mxCell>

        <!-- A · template (existing) -->
        <mxCell id="A" value="kacey_routine_block  ·  DEFAULT WEEK (existing)" style="swimlane;fontStyle=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;rounded=1;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;whiteSpace=wrap;" vertex="1" parent="1">

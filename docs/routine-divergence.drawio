        <mxCell id="A7" value="&lt;i&gt;Prefills every date with its weekday's blocks. Written by the planner and by app_routine_paint. &lt;b&gt;Not changed by this feature.&lt;/b&gt;&lt;/i&gt;" style="text;strokeColor=none;fillColor=#f3f8fe;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=8;html=1;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="A"><mxGeometry y="174" width="300" height="64" as="geometry" /></mxCell>


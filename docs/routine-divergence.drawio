        <mxCell id="d4f" value="The doctor's appointment sits side by side with study. Whether study is cancelled is up to Kacey.&lt;br&gt;The move is a cancel plus an add sharing group 7." style="text;html=1;whiteSpace=wrap;fontSize=10;fontColor=#4e6f99;align=left;verticalAlign=top;fontStyle=2;" vertex="1" parent="d4"><mxGeometry x="10" y="200" width="180" height="80" as="geometry" /></mxCell>


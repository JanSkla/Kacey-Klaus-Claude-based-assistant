        <mxCell id="A2" value="PK slot     INTEGER 0–95 (15 min)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="A"><mxGeometry y="54" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="A3" value="   category TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="A"><mxGeometry y="78" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="A4" value="   note     TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="A"><mxGeometry y="102" width="300" height="24" as="geometry" /></mxCell>
        <mxCell id="A5" value="   room     TEXT" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontFamily=Courier New;fontSize=12;" vertex="1" parent="A"><mxGeometry y="126" width="300" height="24" as="geometry" /></mxCell>

  <diagram id="p4" name="4 · Alterations (UI ⇄ Kacey)">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t4" value="&lt;b&gt;Alterations · every Kacey ability is mirrored in the UI&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot; color=&quot;#666666&quot;&gt;Both go through one function, so they cannot drift apart. The only exception is late amends to cemented days, which are Kacey only.&lt;/font&gt;" style="text;html=1;fontSize=18;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="50" as="geometry" />
        </mxCell>

        <!-- table header -->
        <mxCell id="h1" value="Ability" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#999999;fontStyle=1;align=left;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="200" height="32" as="geometry" /></mxCell>

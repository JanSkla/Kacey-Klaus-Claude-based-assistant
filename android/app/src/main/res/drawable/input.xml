<?xml version="1.0" encoding="utf-8"?>
<!-- .input: bg field, 1px line2 border, square; 2dp acc border while focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
            <stroke android:width="2dp" android:color="@color/acc" />
            <padding android:left="12dp" android:right="12dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
            <stroke android:width="1dp" android:color="@color/line2" />
            <padding android:left="12dp" android:right="12dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>

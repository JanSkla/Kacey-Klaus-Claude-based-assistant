<?xml version="1.0" encoding="utf-8"?>
<!-- One row of the STAV box (Claude Design "Kacey Android" 1a–1c): an 8dp
     dot, the name, the state word on the right, and an optional action.
     MainActivity fills it; the background turns l2 with a 4dp acc edge when
     the row is the current one (the bubble on screen). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="6dp">

    <View
        android:id="@+id/dot"
        android:layout_width="8dp"
        android:layout_height="8dp" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:textColor="@color/ink"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textSize="13sp" />

    <Button
        android:id="@+id/action"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:textAllCaps="false"
        android:textSize="13sp"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher screen, from Claude Design "Kacey Android" 1a–1c: the state
     leads (a STAV list, each fix next to what it fixes), one primary action,
     the server address, and a footer pinned to the bottom. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/acc" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Bublina nad jakoukoli aplikací, sdílení snímků obrazovky a oznámení telefonu v Kacey."
            android:textColor="@color/ink2"
            android:textSize="14sp" />

        <!-- STAV -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:letterSpacing="0.08"
            android:text="STAV"
            android:textColor="@color/ink3"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/box_l1"
            android:orientation="vertical"
            android:padding="1dp">
            <include android:id="@+id/rowNotif" layout="@layout/status_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/rowMic" layout="@layout/status_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/rowBubbles" layout="@layout/status_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/rowBubble" layout="@layout/status_row" />
            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />
            <include android:id="@+id/rowRelay" layout="@layout/status_row" />
        </LinearLayout>

        <Button
            android:id="@+id/bubble"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_accent"
            android:text="Zobrazit bublinu"
            android:textAllCaps="false"
            android:textColor="@color/on_acc"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/bubbleNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nejdřív zapni bubliny v systému."
            android:textColor="@color/ink3"
            android:textSize="13sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/open"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn"
            android:text="Otevřít na celou obrazovku"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <!-- SERVER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="SERVER"
            android:textColor="@color/ink3"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/url"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/input"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:singleLine="true"
                android:textColor="@color/ink"
                android:textColorHint="@color/ink3"
                android:textSize="16sp" />
            <Button
                android:id="@+id/save"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="Uložit"
                android:textAllCaps="false"
                android:textColor="@color/ink"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/urlNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Adresa kaceybody v tailnetu, https."
            android:textColor="@color/ink3"
            android:textSize="13sp" />

        <!-- Pushes the footer to the bottom when there is room. -->
        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:lineSpacingMultiplier="1.3"
            android:text="Snímek obrazovky pošleš přes Sdílet → Kacey. Odtaženou bublinu vrátí dlaždice „Kacey bublina“ v rychlém nastavení. Přeposílání oznámení jen čte lištu oznámení; k účtům aplikací se nikdy nepřihlašuje."
            android:textColor="@color/ink3"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher screen, in Kacey's own look: bg, monospace, square
     controls, one accent. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <View
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:background="@color/acc" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:letterSpacing="0.04"
                android:text="@string/app_name"
                android:textColor="@color/ink"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Bublina nad jakoukoli aplikací a sdílení snímků obrazovky Kacey."
            android:textColor="@color/ink2"
            android:textSize="14sp" />

        <!-- Status -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/l1"
            android:lineSpacingMultiplier="1.3"
            android:padding="14dp"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/bubble"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_accent"
            android:text="Zobrazit bublinu"
            android:textAllCaps="false"
            android:textColor="@color/on_acc"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/open"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn"
            android:text="Otevřít Kacey na celou obrazovku"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/perms"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn"
            android:text="Povolit oznámení a mikrofon"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <Button
            android:id="@+id/bubbleSettings"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn"
            android:text="Nastavení bublin v systému"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <!-- Server -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.08"
            android:text="SERVER"
            android:textColor="@color/ink3"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/input"
            android:hint="https://kaceybody.….ts.net"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/ink"
            android:textColorHint="@color/ink3"
            android:textSize="16sp" />

        <Button
            android:id="@+id/save"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Uložit adresu"
            android:textAllCaps="false"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingMultiplier="1.4"
            android:text="Snímek obrazovky pošleš přes Sdílet → Kacey. Otevře se v bublině s obrázkem v konceptu; připiš vzkaz, nebo rovnou odešli.\n\nBublinu, kterou odtáhneš pryč, vrátí dlaždice „Kacey bublina“ v rychlém nastavení."
            android:textColor="@color/ink3"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
